# Point d'entrée unique : l'URL de l'API Laravel, qui finit par /api
# Les services /chat/* et /blockchain/* y sont relayés par la gateway
VITE_APP_BACKEND_URL=

VITE_PUSHER_APP_ID=
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_SECRET=

# Socket.io du chat : ne peut pas passer par la gateway HTTP, à exposer séparément
VITE_APP_SOCKET_URL=

VITE_PEERJS_PORT=
